// LWDPM — the vendored ProseMirror surface for the Living Document webview.
// Built offline (decision 43/46) into an ASCII IIFE and base64-vendored into
// src/vs/workbench/contrib/livingDocs/browser/prosemirrorBundle.ts.
//
// Exposes window.LWDPM = { mount, toMarkdown, cmd, destroy, roundTrip, docJSON }.
// The keystone (decision 46): a bound figure `[label](bind:key)` is a first-class
// atom inline node (bound_figure) — non-editable, renders the resolved value, and
// serializes back to `[label](bind:key)` so it round-trips on disk.

import { Schema } from 'prosemirror-model';
import { EditorState, Plugin, PluginKey } from 'prosemirror-state';
import { EditorView, Decoration, DecorationSet } from 'prosemirror-view';
import {
	schema as mdSchema,
	defaultMarkdownParser,
	defaultMarkdownSerializer,
	MarkdownParser,
	MarkdownSerializer
} from 'prosemirror-markdown';
import { keymap } from 'prosemirror-keymap';
import { history, undo, redo } from 'prosemirror-history';
import { baseKeymap, toggleMark, setBlockType, wrapIn } from 'prosemirror-commands';
import { wrapInList, splitListItem, liftListItem, sinkListItem } from 'prosemirror-schema-list';
import markdownit from 'markdown-it';

// --- Schema: the commonmark schema + a bound_figure atom inline node ----------
// prosemirror-markdown ships `heading` with the content expression `(text | image)*` rather than
// `inline*`, so ANY inline atom we add is invalid inside a heading. That is not a cosmetic limit: an
// invalid child makes `createAndFill` return null, the parser drops the whole heading, and the document
// collapses to a single empty paragraph - which the 300ms autosave would then write to disk. That was
// already true on main for `## Heading with [x](bind:key)` (data loss nobody had hit, because the sample
// corpus keeps figures out of headings); a wikilink in a heading is an explicit WP-C requirement, so the
// expression is widened here to admit exactly the two atoms this schema adds - nothing else, so a
// hard_break in a heading is still dropped the way upstream intends.
const headingSpec = mdSchema.spec.nodes.get('heading');
const nodes = mdSchema.spec.nodes.update('heading', Object.assign({}, headingSpec, {
	content: '(text | image | bound_figure | wikilink)*'
})).addToEnd('bound_figure', {
	inline: true,
	group: 'inline',
	atom: true,        // a single indivisible unit — the cursor can't enter it
	selectable: true,
	draggable: false,
	attrs: { label: { default: '' }, key: { default: '' } },
	toDOM(node) {
		// The label carries the (already-resolved) value baked into the clean file;
		// a live resolver may override the displayed text at mount time. data-key lets
		// the webview wire a source-peek click; contenteditable=false protects it.
		return ['span', {
			'class': 'bound',
			'data-key': node.attrs.key,
			'data-label': node.attrs.label,
			'contenteditable': 'false'
		}, node.attrs.label];
	},
	parseDOM: [{
		tag: 'span.bound',
		getAttrs(dom) {
			return {
				key: dom.getAttribute('data-key') || '',
				label: dom.getAttribute('data-label') || dom.textContent || ''
			};
		}
	}]
}).addToEnd('table_block', {
	// A GFM table is a single read-only block atom: it captures the table's Markdown at parse
	// time, renders it as a real HTML table (bound figures inside cells stay clickable), and
	// serializes the captured Markdown back verbatim. Read-only in PM matches the product's
	// "figures are bound, not hand-edited" stance; the raw-Markdown toggle is the edit path.
	group: 'block',
	atom: true,
	isolating: true,
	attrs: { markdown: { default: '' } },
	toDOM(node) { return tableDom(node.attrs.markdown); },
	parseDOM: [{ tag: 'table[data-md]', getAttrs(dom) { return { markdown: dom.getAttribute('data-md') || '' }; } }]
}).addToEnd('wikilink', {
	// A `[[Doc Name]]` wikilink (decision 179, plan 52 WP-C) - Obsidian's link grammar, kept byte-for-byte
	// on disk. It has to be a first-class schema node for one hard reason: prosemirror-markdown's text
	// serializer escapes `[` and `]`, so a wikilink left as plain text is written back to disk as
	// `\[\[Doc Name\]\]` the first time the document round-trips, silently breaking Obsidian compatibility.
	// As an ATOM the caret can never land between the brackets, and the serializer node below writes the
	// exact source form back. `alias` carries Obsidian's `[[Target|Shown text]]` form ('' when absent).
	inline: true,
	group: 'inline',
	atom: true,
	selectable: true,
	draggable: false,
	attrs: { target: { default: '' }, alias: { default: '' } },
	toDOM(node) {
		// The webview marks resolved vs unresolved by adding a class here at render time (it alone knows
		// which documents exist); the bundle only states the target and the visible text.
		return ['span', {
			'class': 'wikilink',
			'data-target': node.attrs.target,
			'data-alias': node.attrs.alias,
			'contenteditable': 'false'
		}, node.attrs.alias || node.attrs.target];
	},
	parseDOM: [{
		tag: 'span.wikilink',
		getAttrs(dom) {
			return {
				target: dom.getAttribute('data-target') || '',
				alias: dom.getAttribute('data-alias') || ''
			};
		}
	}]
});
const schema = new Schema({ nodes, marks: mdSchema.spec.marks });

// --- Markdown parser: convert `[label](bind:key)` links into bound_figure ------
const md = markdownit('commonmark', { html: false });
// CommonMark has no tables; turn the GFM table block rule back on so `| a | b |` parses.
md.enable(['table']);
// When the cell renderer (renderCellHtml -> md.renderInline) hits a bind link, the bound_figure core
// rule below has already folded it into a `bound_figure` token. markdown-it's default token renderer
// would emit it as garbage (`< key=.. label=.. />`, an empty-tag token), so give the token an explicit
// renderer rule: a clickable .bound span (same markup as the PM node's toDOM) so source-peek still works.
md.renderer.rules.bound_figure = (tokens, idx) => {
	const t = tokens[idx];
	const key = md.utils.escapeHtml(t.attrGet('key') || '');
	const label = md.utils.escapeHtml(t.attrGet('label') || t.content || '');
	return '<span class="bound" data-key="' + key + '" data-label="' + label + '" contenteditable="false">' + label + '</span>';
};
// Same reason as bound_figure: a wikilink inside a table cell is rendered through md.renderInline, so the
// token needs an explicit renderer rule or markdown-it emits an empty-tag placeholder.
md.renderer.rules.wikilink = (tokens, idx) => {
	const t = tokens[idx];
	const target = md.utils.escapeHtml(t.attrGet('target') || '');
	const alias = md.utils.escapeHtml(t.attrGet('alias') || '');
	return '<span class="wikilink" data-target="' + target + '" data-alias="' + alias + '" contenteditable="false">' + (alias || target) + '</span>';
};
// An INLINE rule (not a core rule) for `[[Target]]` / `[[Target|Shown text]]`, registered before `link` so a
// wikilink is claimed before CommonMark's link parser sees the brackets. Being an inline rule is what makes
// `[[` inert inside code: a fenced block is a `fence` token whose content is never inline-parsed, and an
// inline code span is consumed by the `backticks` rule (which is registered earlier), so this rule is never
// reached inside either. `\[\[x\]\]` also stays literal, because the `escape` rule runs earlier still.
function wikilinkRule(state, silent) {
	const src = state.src;
	const start = state.pos;
	if (src.charCodeAt(start) !== 0x5B /* [ */ || src.charCodeAt(start + 1) !== 0x5B) {
		return false;
	}
	const close = src.indexOf(']]', start + 2);
	if (close < 0 || close > state.posMax) {
		return false;
	}
	const inner = src.slice(start + 2, close);
	// A wikilink never spans a line break and never nests a bracket - both mean this is ordinary text.
	if (!inner.length || /[\n\[\]]/.test(inner)) {
		return false;
	}
	const bar = inner.indexOf('|');
	const target = (bar < 0 ? inner : inner.slice(0, bar)).trim();
	const alias = bar < 0 ? '' : inner.slice(bar + 1).trim();
	if (!target) {
		return false;
	}
	if (!silent) {
		const tok = state.push('wikilink', '', 0);
		tok.attrSet('target', target);
		tok.attrSet('alias', alias);
		tok.content = alias || target;
	}
	state.pos = close + 2;
	return true;
}
md.inline.ruler.before('link', 'wikilink', wikilinkRule);

// A core rule (runs after inline parsing) that folds a bind: link's
// link_open / text / link_close run into a single self-contained bound_figure token.
md.core.ruler.push('bound_figure', state => {
	for (const blockToken of state.tokens) {
		if (blockToken.type !== 'inline' || !blockToken.children) {
			continue;
		}
		const children = blockToken.children;
		const out = [];
		for (let i = 0; i < children.length; i++) {
			const t = children[i];
			if (t.type === 'link_open') {
				const href = t.attrGet('href') || '';
				if (href.indexOf('bind:') === 0) {
					let j = i + 1;
					let label = '';
					while (j < children.length && children[j].type !== 'link_close') {
						label += children[j].content || '';
						j++;
					}
					const tok = new state.Token('bound_figure', '', 0);
					tok.attrSet('key', href.slice('bind:'.length));
					tok.attrSet('label', label);
					tok.content = label;
					out.push(tok);
					i = j; // skip past the consumed link_close
					continue;
				}
			}
			out.push(t);
		}
		blockToken.children = out;
	}
});

// A core rule (runs after block + inline parsing) that collapses a markdown-it table token run
// (table_open ... table_close, with thead/tbody/tr/th/td wrappers) into ONE self-contained
// table_block token. The token's `markdown` attr is the table re-serialized to canonical GFM from
// each cell's raw inline `.content`, so it round-trips byte-for-byte and serializes back verbatim.
function escTableCell(text) {
	return String(text).replace(/\|/g, '\\|');
}
function buildTableMarkdown(rows, aligns) {
	if (!rows.length) { return ''; }
	const header = rows[0].cells;
	const n = header.length;
	const sep = [];
	for (let k = 0; k < n; k++) {
		const a = aligns[k] || '';
		sep.push(a === 'left' ? ':---' : a === 'center' ? ':---:' : a === 'right' ? '---:' : '---');
	}
	const lines = [];
	lines.push('| ' + header.map(escTableCell).join(' | ') + ' |');
	lines.push('| ' + sep.join(' | ') + ' |');
	for (let r = 1; r < rows.length; r++) {
		lines.push('| ' + rows[r].cells.map(escTableCell).join(' | ') + ' |');
	}
	return lines.join('\n');
}
md.core.ruler.push('table_block', state => {
	const toks = state.tokens;
	const out = [];
	for (let i = 0; i < toks.length; i++) {
		if (toks[i].type !== 'table_open') { out.push(toks[i]); continue; }
		const rows = [];
		const aligns = [];
		let inHeader = false;
		let curRow = null;
		let j = i + 1;
		for (; j < toks.length && toks[j].type !== 'table_close'; j++) {
			const t = toks[j];
			if (t.type === 'thead_open') { inHeader = true; }
			else if (t.type === 'thead_close') { inHeader = false; }
			else if (t.type === 'tr_open') { curRow = { cells: [] }; }
			else if (t.type === 'tr_close') { if (curRow) { rows.push(curRow); } curRow = null; }
			else if (t.type === 'th_open' || t.type === 'td_open') {
				const inline = toks[j + 1];
				const content = (inline && inline.type === 'inline') ? (inline.content || '') : '';
				if (curRow) { curRow.cells.push(content.trim()); }
				if (inHeader) {
					const style = t.attrGet ? (t.attrGet('style') || '') : '';
					aligns.push(style.indexOf('left') >= 0 ? 'left' : style.indexOf('center') >= 0 ? 'center' : style.indexOf('right') >= 0 ? 'right' : '');
				}
			}
		}
		const markdown = buildTableMarkdown(rows, aligns);
		const tok = new state.Token('table_block', '', 0);
		tok.attrSet('markdown', markdown);
		tok.content = markdown;
		tok.block = true;
		out.push(tok);
		i = j; // skip the consumed run up to and including table_close (loop ++ steps past it)
	}
	state.tokens = out;
});

const parser = new MarkdownParser(schema, md, Object.assign({}, defaultMarkdownParser.tokens, {
	bound_figure: {
		node: 'bound_figure',
		getAttrs: tok => ({ key: tok.attrGet('key') || '', label: tok.attrGet('label') || '' })
	},
	table_block: {
		node: 'table_block',
		getAttrs: tok => ({ markdown: tok.attrGet('markdown') || tok.content || '' })
	},
	wikilink: {
		node: 'wikilink',
		getAttrs: tok => ({ target: tok.attrGet('target') || '', alias: tok.attrGet('alias') || '' })
	}
}));

// --- Markdown serializer: write bound_figure back as `[label](bind:key)` -------
const serializer = new MarkdownSerializer(
	Object.assign({}, defaultMarkdownSerializer.nodes, {
		bound_figure(state, node) {
			state.text('[' + node.attrs.label + '](bind:' + node.attrs.key + ')', false);
		},
		table_block(state, node) {
			state.write(node.attrs.markdown || '');
			state.closeBlock(node);
		},
		// `false` = do not escape: the brackets ARE the syntax, and escaping them is exactly the bug this
		// node exists to prevent. The alias is written back only when the source carried one.
		wikilink(state, node) {
			const alias = node.attrs.alias;
			state.text('[[' + node.attrs.target + (alias ? '|' + alias : '') + ']]', false);
		}
	}),
	defaultMarkdownSerializer.marks
);

// --- Decorations: pending proposals (inline diff / inserts) + provenance gutter ---
// The host computes a serializable spec (text-anchored, decision 47 / plan 15 iter 4) and pushes it via
// setDecorations; this plugin just holds the resulting DecorationSet and re-maps it across edits. The diff
// and insert widgets carry host-rendered HTML so they match the renderDoc markup byte-for-byte (one look).
const decoKey = new PluginKey('lwdDeco');
function decoPlugin() {
	return new Plugin({
		key: decoKey,
		state: {
			init() { return DecorationSet.empty; },
			apply(tr, old) {
				const next = tr.getMeta(decoKey);
				if (next) { return next; }
				return old.map(tr.mapping, tr.doc);
			}
		},
		props: { decorations(state) { return decoKey.getState(state); } }
	});
}

function htmlToDom(html) {
	const el = document.createElement('div');
	el.innerHTML = html || '';
	return el;
}

// --- Read-only table rendering (toDOM for table_block) -------------------------
// Render a cell's inline Markdown to HTML via the same markdown-it instance (so bold/italic/links
// behave), then convert any `bind:` link into a clickable .bound span so source-peek still works.
function renderCellHtml(src) {
	// md.renderInline runs the core ruler, so bind links are already bound_figure tokens; the
	// bound_figure renderer rule (above) turns them into clickable .bound spans. Bold/italic/links
	// render normally. html:false on `md` keeps any stray HTML in the cell escaped.
	return md.renderInline(src || '');
}
function splitTableRow(line) {
	let s = line.trim();
	if (s.charAt(0) === '|') { s = s.slice(1); }
	if (s.charAt(s.length - 1) === '|') { s = s.slice(0, -1); }
	const cells = [];
	let buf = '';
	for (let i = 0; i < s.length; i++) {
		const ch = s.charAt(i);
		if (ch === '\\' && s.charAt(i + 1) === '|') { buf += '|'; i++; continue; }
		if (ch === '|') { cells.push(buf.trim()); buf = ''; continue; }
		buf += ch;
	}
	cells.push(buf.trim());
	return cells;
}
function isSeparatorRow(cells) {
	return cells.length > 0 && cells.every(c => /^:?-+:?$/.test(c.replace(/\s/g, '')));
}
function alignOf(cell) {
	const c = cell.replace(/\s/g, '');
	const left = c.charAt(0) === ':';
	const right = c.charAt(c.length - 1) === ':';
	if (left && right) { return 'center'; }
	if (right) { return 'right'; }
	if (left) { return 'left'; }
	return '';
}
function tableDom(markdown) {
	const tbl = document.createElement('table');
	tbl.className = 'lwd-table';
	tbl.setAttribute('data-md', markdown || '');
	const lines = String(markdown || '').split('\n').map(l => l.trim()).filter(l => l.length);
	const thead = document.createElement('thead');
	const tbody = document.createElement('tbody');
	let aligns = [];
	let headerDone = false;
	for (let i = 0; i < lines.length; i++) {
		const cells = splitTableRow(lines[i]);
		if (isSeparatorRow(cells)) { aligns = cells.map(alignOf); headerDone = true; continue; }
		const tr = document.createElement('tr');
		const tag = headerDone ? 'td' : 'th';
		for (let c = 0; c < cells.length; c++) {
			const cell = document.createElement(tag);
			if (aligns[c]) { cell.style.textAlign = aligns[c]; }
			cell.innerHTML = renderCellHtml(cells[c]);
			tr.appendChild(cell);
		}
		(headerDone ? tbody : thead).appendChild(tr);
	}
	if (thead.childNodes.length) { tbl.appendChild(thead); }
	if (tbody.childNodes.length) { tbl.appendChild(tbody); }
	return tbl;
}

// Resolve the text-anchored spec into ProseMirror decorations against the live doc: a pending edit hides
// its block and renders the diff+controls widget in its place; a generative insert is an all-additions
// widget after its anchor block (or at the end); every source-bound block gets a provenance gutter marker.
function setDecorations(view, spec) {
	const s = spec || {};
	const doc = view.state.doc;
	const edits = s.edits || [];
	const inserts = s.inserts || [];
	// The numbered rail (plan 45 pin 9): the host sends one ordered entry per Markdown block. `doc.blocks`
	// order maps 1:1 to the top-level ProseMirror node order (both come from the same blank-line block split),
	// so we zip `numbers[blockIndex]` onto the node as it is visited in document order - no text matching.
	// Each entry = { line, tone: 'idle'|'bound'|'pending', keys, recent }; the tone drives the number colour +
	// dot/bar, `data-lwd-num` carries the display number the CSS ::before prints (blank on wrapped rows).
	const numbers = s.numbers || [];
	const decos = [];
	let blockIndex = 0;
	doc.forEach((node, offset) => {
		const start = offset;
		const end = offset + node.nodeSize;
		const text = (node.textContent || '').trim();
		let hidden = false;
		if (text.length) {
			for (let i = 0; i < edits.length; i++) {
				const e = edits[i];
				if ((e.anchorText || '').trim() === text) {
					decos.push(Decoration.node(start, end, { class: 'pm-orig-hidden' }));
					decos.push(Decoration.widget(start, htmlToDom(e.html), { side: -1, key: 'edit-' + e.id, stopEvent: () => true, ignoreSelection: true }));
					hidden = true;
					break;
				}
			}
		}
		// Paint this block's gutter number (skip a block whose original node is hidden behind an edit widget -
		// the widget carries the attention bar itself). The tone class colours the number + adds the dot/bar.
		const entry = numbers[blockIndex];
		if (entry && !hidden) {
			const tone = entry.tone === 'bound' ? (entry.recent ? 'pm-num bound recent' : 'pm-num bound')
				: entry.tone === 'pending' ? 'pm-num pending' : 'pm-num';
			decos.push(Decoration.node(start, end, { class: tone, 'data-lwd-num': String(entry.line) }));
		}
		blockIndex++;
	});
	for (let i = 0; i < inserts.length; i++) {
		const ins = inserts[i];
		let pos = doc.content.size;
		if (ins.afterText !== null && ins.afterText !== undefined) {
			const want = String(ins.afterText).trim();
			doc.forEach((node, offset) => {
				if ((node.textContent || '').trim() === want) { pos = offset + node.nodeSize; }
			});
		}
		decos.push(Decoration.widget(pos, htmlToDom(ins.html), { side: 1, key: 'insert-' + ins.id, stopEvent: () => true, ignoreSelection: true }));
	}
	view.dispatch(view.state.tr.setMeta(decoKey, DecorationSet.create(doc, decos)));
}

// Replace the whole document with freshly-parsed Markdown WITHOUT tearing down the EditorView (so the
// ~370KB bundle is never re-inlined). Used after a model-driven body change (an accepted proposal): the
// live PM body resets to disk truth, then the host re-pushes the decoration spec.
// The plugins are REBUILT (not reused) so `history()` starts fresh: undo is scoped to the current
// editing session between service writes. A service write (approve/restore) must never be undoable via
// Cmd+Z, or an approved change could be silently reverted without an audit entry (plan 26 iter 1).
function setDoc(view, markdown) {
	const doc = parser.parse(markdown || '');
	const state = EditorState.create({ doc, plugins: buildPlugins() });
	view.updateState(state);
}

// --- Editor plumbing ----------------------------------------------------------
function buildPlugins() {
	return [
		decoPlugin(),
		history(),
		keymap({ 'Mod-z': undo, 'Mod-y': redo, 'Shift-Mod-z': redo }),
		// List behaviour first: Enter splits a list item INSIDE a list; outside a
		// list splitListItem returns false so baseKeymap's Enter makes a paragraph.
		keymap({
			'Enter': splitListItem(schema.nodes.list_item),
			'Tab': sinkListItem(schema.nodes.list_item),
			'Shift-Tab': liftListItem(schema.nodes.list_item)
		}),
		keymap(baseKeymap)
	];
}

function mount(parent, markdown, options) {
	const opts = options || {};
	// The clean-file format bakes the resolved value into each bound figure's label,
	// so the NodeView renders the live value directly. (A live-resolver override at
	// mount time is a later iteration's concern.)
	const doc = parser.parse(markdown || '');
	const state = EditorState.create({ doc, plugins: buildPlugins() });
	const view = new EditorView(parent, {
		state,
		editable: () => opts.editable !== false,
		dispatchTransaction(tr) {
			const next = view.state.apply(tr);
			view.updateState(next);
			if (tr.docChanged && typeof opts.onChange === 'function') {
				opts.onChange();
			}
		}
	});
	return view;
}

function toMarkdown(view) {
	return serializer.serialize(view.state.doc);
}

const COMMANDS = {
	bold: toggleMark(schema.marks.strong),
	italic: toggleMark(schema.marks.em),
	bullet_list: wrapInList(schema.nodes.bullet_list),
	ordered_list: wrapInList(schema.nodes.ordered_list),
	blockquote: wrapIn(schema.nodes.blockquote),
	h1: setBlockType(schema.nodes.heading, { level: 1 }),
	h2: setBlockType(schema.nodes.heading, { level: 2 }),
	h3: setBlockType(schema.nodes.heading, { level: 3 }),
	paragraph: setBlockType(schema.nodes.paragraph),
	// Keystroke-level history (plan 26 iter 1). Cmd+Z / Cmd+Shift+Z are also bound in the keymap, but
	// exposing them as commands lets the host drive undo/redo and lets a headless test assert that undo
	// is a no-op after setDoc (history is scoped to the current editing session between service writes).
	undo: undo,
	redo: redo
};

function cmd(view, name) {
	const command = COMMANDS[name];
	if (!command) {
		return false;
	}
	const ok = command(view.state, view.dispatch, view);
	view.focus();
	return ok;
}

function destroy(view) {
	if (view && typeof view.destroy === 'function') {
		view.destroy();
	}
}

// --- Headless helpers (no DOM) for unit tests of the round-trip ----------------
function roundTrip(markdown) {
	return serializer.serialize(parser.parse(markdown || ''));
}
function docJSON(markdown) {
	return parser.parse(markdown || '').toJSON();
}

window.LWDPM = { mount, toMarkdown, cmd, destroy, roundTrip, docJSON, setDecorations, setDoc };
